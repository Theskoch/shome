# Скопируй в .env и поправь под себя: cp .env.example .env
# .env в git не попадает (см. .gitignore).

# Порт на хосте. Портал будет на http://<ip-хоста>:${HOST_PORT}
HOST_PORT=8080

TZ=Europe/Moscow

# Ключ подписи сессий. Если пусто — берётся secret_key из config/ldap_config.json.
# Сгенерировать: openssl rand -hex 32
# Менять нельзя без нужды: смена ключа разлогинивает всех.
SHOME_SECRET_KEY=

# Сколько дней живёт сессия пользователя.
SHOME_SESSION_DAYS=30

# Защита от перебора паролей: сколько попыток входа даётся с одного IP
# и на сколько минут вход блокируется после их исчерпания.
# После паузы счётчик обнуляется и даётся новая пачка попыток.
SHOME_LOGIN_MAX_ATTEMPTS=10
SHOME_LOGIN_BLOCK_MINUTES=5

# Сколько реверс-прокси стоит перед порталом.
#   0 — открываешь напрямую по http://ip:порт
#   1 — за Nginx Proxy Manager / nginx / caddy  ← твой случай
# Нужно, чтобы защита от перебора видела IP клиента, а не IP прокси.
# Не ставь больше, чем прокси на самом деле: лишний хоп = клиент подделает свой IP.
SHOME_TRUST_PROXY=0

# 1 — если портал открывается по https (NPM с сертификатом).
# Кука сессии тогда не уйдёт по открытому http. При прямом http://ip:порт не включай:
# браузер просто не сохранит куку и войти не получится.
SHOME_SECURE_COOKIES=0

# Максимальный размер загружаемой картинки, МБ.
# Если поднимешь — подними и client_max_body_size в NPM (вкладка Advanced).
SHOME_MAX_UPLOAD_MB=25

# Имя docker-сети Nginx Proxy Manager (docker network ls).
# Нужно только если раскомментируешь блок networks в docker-compose.yml.
NPM_NETWORK=nginx-proxy-manager_default

# UID/GID владельца каталога ./data — от них контейнер пишет файлы.
# Подсмотреть свои: id -u && id -g
PUID=1000
PGID=1000
